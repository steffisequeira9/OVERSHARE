# Port for the proxy server
PORT=3000

# Google Gemini API Key (never stored in the mobile app)
GEMINI_API_KEY=your_gemini_api_key_here

# Selected model: gemini-2.5-flash-lite (high speed, cost-effective, structured outputs, enterprise data privacy)
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional shared proxy secret header (X-Proxy-Secret)
PROXY_SECRET=
